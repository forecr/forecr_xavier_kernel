/dts-v1/;
/plugin/;

#include <dt-bindings/tegra234-p3737-0000+p3701-0000.h>
#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>

#define CAMERA_I2C_MUX_BUS(x) (0x28 + x)

/ {
	overlay-name = "dsaddon mipi camera";
	jetson-header-name = "Jetson AGX CSI Connector";
	compatible = JETSON_COMPATIBLE;

	fragment-camera@0 {
		target-path = "/";
		__overlay__ {
			tegra-capture-vi {
				num-channels = <6>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						status = "okay";
						reg = <0>;
						dsaddon_mipi_vi_in0: endpoint {
							status = "okay";
							port-index = <0>;
							bus-width = <2>;
							remote-endpoint = <&dsaddon_mipi_csi_out0>;
						};
					};
					port@1 {
						status = "okay";
						reg = <1>;
						dsaddon_mipi_vi_in1: endpoint {
							status = "okay";
							port-index = <1>;
							bus-width = <2>;
							remote-endpoint = <&dsaddon_mipi_csi_out1>;
						};
					};
					port@2 {
						status = "okay";
						reg = <2>;
						dsaddon_mipi_vi_in2: endpoint {
							status = "okay";
							port-index = <2>;
							bus-width = <2>;
							remote-endpoint = <&dsaddon_mipi_csi_out2>;
						};
					};
					port@3 {
						status = "okay";
						reg = <3>;
						dsaddon_mipi_vi_in3: endpoint {
							status = "okay";
							port-index = <3>;
							bus-width = <2>;
							remote-endpoint = <&dsaddon_mipi_csi_out3>;
						};
					};
					port@4 {
						status = "okay";
						reg = <4>;
						dsaddon_mipi_vi_in4: endpoint {
							status = "okay";
							port-index = <4>;
							bus-width = <2>;
							remote-endpoint = <&dsaddon_mipi_csi_out4>;
						};
					};
					port@5 {
						status = "okay";
						reg = <5>;
						dsaddon_mipi_vi_in5: endpoint {
							status = "okay";
							port-index = <5>;
							bus-width = <2>;
							remote-endpoint = <&dsaddon_mipi_csi_out5>;
						};
					};
				};
			};

			bus@0 {
				host1x@13e00000 {
					nvcsi@15a00000 {
						num-channels = <6>;
						#address-cells = <1>;
						#size-cells = <0>;
						status = "okay";

						channel@0 {
							status = "okay";
							reg = <0>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									status = "okay";
									reg = <0>;
									dsaddon_mipi_csi_in0: endpoint@0 {
										status = "okay";
										port-index = <0>;
										bus-width = <2>;
										remote-endpoint = <&dsaddon_mipi_out0>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									dsaddon_mipi_csi_out0: endpoint@1 {
										status = "okay";
										remote-endpoint = <&dsaddon_mipi_vi_in0>;
									};
								};
							};
						};
						channel@1 {
							status = "okay";
							reg = <1>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									status = "okay";
									reg = <0>;
									dsaddon_mipi_csi_in1: endpoint@2 {
										status = "okay";
										port-index = <1>;
										bus-width = <2>;
										remote-endpoint = <&dsaddon_mipi_out1>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									dsaddon_mipi_csi_out1: endpoint@3 {
										status = "okay";
										remote-endpoint = <&dsaddon_mipi_vi_in1>;
									};
								};
							};
						};
						channel@2 {
							status = "okay";
							reg = <2>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									status = "okay";
									reg = <0>;
									dsaddon_mipi_csi_in2: endpoint@4 {
										status = "okay";
										port-index = <2>;
										bus-width = <2>;
										remote-endpoint = <&dsaddon_mipi_out2>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									dsaddon_mipi_csi_out2: endpoint@5 {
										status = "okay";
										remote-endpoint = <&dsaddon_mipi_vi_in2>;
									};
								};
							};
						};
						channel@3 {
							status = "okay";
							reg = <3>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									status = "okay";
									reg = <0>;
									dsaddon_mipi_csi_in3: endpoint@6 {
										status = "okay";
										port-index = <3>;
										bus-width = <2>;
										remote-endpoint = <&dsaddon_mipi_out3>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									dsaddon_mipi_csi_out3: endpoint@7 {
										status = "okay";
										remote-endpoint = <&dsaddon_mipi_vi_in3>;
									};
								};
							};
						};
						channel@4 {
							status = "okay";
							reg = <4>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									status = "okay";
									reg = <0>;
									dsaddon_mipi_csi_in4: endpoint@8 {
										status = "okay";
										port-index = <4>;
										bus-width = <2>;
										remote-endpoint = <&dsaddon_mipi_out4>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									dsaddon_mipi_csi_out4: endpoint@9 {
										status = "okay";
										remote-endpoint = <&dsaddon_mipi_vi_in4>;
									};
								};
							};
						};
						channel@5 {
							status = "okay";
							reg = <5>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									status = "okay";
									reg = <0>;
									dsaddon_mipi_csi_in5: endpoint@10 {
										status = "okay";
										port-index = <6>;
										bus-width = <2>;
										remote-endpoint = <&dsaddon_mipi_out5>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									dsaddon_mipi_csi_out5: endpoint@11 {
										status = "okay";
										bus-width = <2>;
										remote-endpoint = <&dsaddon_mipi_vi_in5>;
									};
								};
							};
						};
					};
				};

				i2c@3180000 {
					status = "okay";
					#address-cells = <1>;
					#size-cells = <0>;

					tca9548_70: tca9548@70 {
						status = "okay";
						compatible = "nxp,pca9548";
						reg = <0x70>;
						#address-cells = <1>;
						#size-cells = <0>;
						i2c-mux-idle-disconnect;
						/*
						 * FIX: idle-state changed from 1 to 0xFF (disconnect).
						 * idle-state = <1> would keep channel 1 selected when
						 * idle, causing I2C collisions between cameras sharing
						 * address 0x10. Use 0xFF or rely on
						 * i2c-mux-idle-disconnect to deselect all channels.
						 */
						idle-state = <0xFF>;
						skip_mux_detect = "yes";
						vcc_lp = "vcc";

						/*
						 * FIX: Move ioexpander to i2c@6 (unchanged) BUT declare
						 * it FIRST so it probes before the camera channels.
						 * The DT overlay node order controls probe sequence.
						 * By listing i2c@6 first, the expander is registered as
						 * a GPIO provider before any camera tries gpiod_get().
						 */
						i2c@6 {
							status = "okay";
							reg = <6>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;

							ioexpander: gpio@38 {
								status = "okay";
								compatible = "nxp,pcf8574a";
								reg = <0x38>;

								/* Required for GPIO provider registration */
								gpio-controller;
								#gpio-cells = <2>;

								/*
								 * FIX: lines-initial-states = <0x3F> was
								 * holding all 6 cameras IN reset at boot.
								 *
								 * PCF8574a quasi-bidirectional logic:
								 *   write 1 → pin floats high (input/released)
								 *   write 0 → pin driven low
								 *
								 * IMX219 XCLR (reset) is ACTIVE LOW:
								 *   LOW  = camera held in reset
								 *   HIGH = camera running normally
								 *
								 * We use GPIO_ACTIVE_LOW in reset-gpios below,
								 * so the GPIO framework inverts for us.
								 * Set all pins HIGH here (0xFF) so cameras
								 * start de-asserted (out of reset) at boot
								 * before the driver takes over.
								 *
								 * ~n_latch in the driver: gpio->out = ~0xFF = 0
								 * means all pins driven low initially, then the
								 * driver sets them high via direction_output.
								 * Use 0x00 here so ~n_latch = 0xFF = all high.
								 */
								lines-initial-states = <0x00>;

								gpio-line-names =
									"RESET_CAM0",
									"RESET_CAM1",
									"RESET_CAM2",
									"RESET_CAM3",
									"RESET_CAM4",
									"RESET_CAM5",
									"N/A",
									"N/A";

								/*
								 * FIX: Removed gpio-hog for pin 2.
								 * A gpio-hog permanently claims the pin inside
								 * the GPIO core. When imx219_c later calls
								 * gpiod_get("reset"), it gets -EBUSY because
								 * the pin is already owned by the hog.
								 * The camera driver manages reset itself.
								 */
							};
						};

						i2c@0 {
							status = "okay";
							reg = <0>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;

							imx219_a@10 {
								status = "okay";
								compatible = "sony,imx219";
								/*
								 * FIX: GPIO_ACTIVE_LOW (IMX219 XCLR is active-low).
								 * Removed GPIO_OPEN_DRAIN — redundant on PCF8574a
								 * and was inconsistent with other camera nodes.
								 */
								reset-gpios = <&ioexpander 0 GPIO_ACTIVE_LOW>;
								reg = <0x10>;
								devnode = "video0";
								physical_w = "3.680";
								physical_h = "2.760";
								sensor_model = "imx219";
								use_sensor_mode_id = "true";

								mode0 {
									mclk_khz = "24000";
									num_lanes = "2";
									tegra_sinterface = "serial_a";
									phy_mode = "DPHY";
									discontinuous_clk = "yes";
									dpcm_enable = "false";
									cil_settletime = "0";
									active_w = "3280";
									active_h = "2464";
									mode_type = "bayer";
									pixel_phase = "rggb";
									csi_pixel_bit_depth = "10";
									readout_orientation = "90";
									line_length = "3448";
									inherent_gain = "1";
									mclk_multiplier = "9.33";
									pix_clk_hz = "182400000";
									gain_factor = "16";
									framerate_factor = "1000000";
									exposure_factor = "1000000";
									min_gain_val = "16";
									max_gain_val = "170";
									step_gain_val = "1";
									default_gain = "16";
									min_hdr_ratio = "1";
									max_hdr_ratio = "1";
									min_framerate = "2000000";
									max_framerate = "21000000";
									step_framerate = "1";
									default_framerate = "21000000";
									min_exp_time = "13";
									max_exp_time = "683709";
									step_exp_time = "1";
									default_exp_time = "2495";
									embedded_metadata_height = "2";
								};
								mode1 {
									mclk_khz = "24000";
									num_lanes = "2";
									tegra_sinterface = "serial_a";
									phy_mode = "DPHY";
									discontinuous_clk = "yes";
									dpcm_enable = "false";
									cil_settletime = "0";
									active_w = "3280";
									active_h = "1848";
									mode_type = "bayer";
									pixel_phase = "rggb";
									csi_pixel_bit_depth = "10";
									readout_orientation = "90";
									line_length = "3448";
									inherent_gain = "1";
									mclk_multiplier = "9.33";
									pix_clk_hz = "182400000";
									gain_factor = "16";
									framerate_factor = "1000000";
									exposure_factor = "1000000";
									min_gain_val = "16";
									max_gain_val = "170";
									step_gain_val = "1";
									default_gain = "16";
									min_hdr_ratio = "1";
									max_hdr_ratio = "1";
									min_framerate = "2000000";
									max_framerate = "28000000";
									step_framerate = "1";
									default_framerate = "28000000";
									min_exp_time = "13";
									max_exp_time = "683709";
									step_exp_time = "1";
									default_exp_time = "2495";
									embedded_metadata_height = "2";
								};
								mode2 {
									mclk_khz = "24000";
									num_lanes = "2";
									tegra_sinterface = "serial_a";
									phy_mode = "DPHY";
									discontinuous_clk = "yes";
									dpcm_enable = "false";
									cil_settletime = "0";
									active_w = "1920";
									active_h = "1080";
									mode_type = "bayer";
									pixel_phase = "rggb";
									csi_pixel_bit_depth = "10";
									readout_orientation = "90";
									line_length = "3448";
									inherent_gain = "1";
									mclk_multiplier = "9.33";
									pix_clk_hz = "182400000";
									gain_factor = "16";
									framerate_factor = "1000000";
									exposure_factor = "1000000";
									min_gain_val = "16";
									max_gain_val = "170";
									step_gain_val = "1";
									default_gain = "16";
									min_hdr_ratio = "1";
									max_hdr_ratio = "1";
									min_framerate = "2000000";
									max_framerate = "30000000";
									step_framerate = "1";
									default_framerate = "30000000";
									min_exp_time = "13";
									max_exp_time = "683709";
									step_exp_time = "1";
									default_exp_time = "2495";
									embedded_metadata_height = "2";
								};
								mode3 {
									mclk_khz = "24000";
									num_lanes = "2";
									tegra_sinterface = "serial_a";
									phy_mode = "DPHY";
									discontinuous_clk = "yes";
									dpcm_enable = "false";
									cil_settletime = "0";
									active_w = "1640";
									active_h = "1232";
									mode_type = "bayer";
									pixel_phase = "rggb";
									csi_pixel_bit_depth = "10";
									readout_orientation = "90";
									line_length = "3448";
									inherent_gain = "1";
									mclk_multiplier = "9.33";
									pix_clk_hz = "182400000";
									gain_factor = "16";
									framerate_factor = "1000000";
									exposure_factor = "1000000";
									min_gain_val = "16";
									max_gain_val = "170";
									step_gain_val = "1";
									default_gain = "16";
									min_hdr_ratio = "1";
									max_hdr_ratio = "1";
									min_framerate = "2000000";
									max_framerate = "30000000";
									step_framerate = "1";
									default_framerate = "30000000";
									min_exp_time = "13";
									max_exp_time = "683709";
									step_exp_time = "1";
									default_exp_time = "2495";
									embedded_metadata_height = "2";
								};
								mode4 {
									mclk_khz = "24000";
									num_lanes = "2";
									tegra_sinterface = "serial_a";
									phy_mode = "DPHY";
									discontinuous_clk = "yes";
									dpcm_enable = "false";
									cil_settletime = "0";
									active_w = "1280";
									active_h = "720";
									mode_type = "bayer";
									pixel_phase = "rggb";
									csi_pixel_bit_depth = "10";
									readout_orientation = "90";
									line_length = "3448";
									inherent_gain = "1";
									mclk_multiplier = "9.33";
									pix_clk_hz = "182400000";
									gain_factor = "16";
									framerate_factor = "1000000";
									exposure_factor = "1000000";
									min_gain_val = "16";
									max_gain_val = "170";
									step_gain_val = "1";
									default_gain = "16";
									min_hdr_ratio = "1";
									max_hdr_ratio = "1";
									min_framerate = "2000000";
									max_framerate = "60000000";
									step_framerate = "1";
									default_framerate = "60000000";
									min_exp_time = "13";
									max_exp_time = "683709";
									step_exp_time = "1";
									default_exp_time = "2495";
									embedded_metadata_height = "2";
								};
								ports {
									#address-cells = <1>;
									#size-cells = <0>;
									port@0 {
										status = "okay";
										reg = <0>;
										dsaddon_mipi_out0: endpoint {
											status = "okay";
											port-index = <0>;
											bus-width = <2>;
											remote-endpoint = <&dsaddon_mipi_csi_in0>;
										};
									};
								};
							};
						};

						i2c@1 {
							status = "okay";
							reg = <1>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;

							imx219_b@10 {
								status = "okay";
								compatible = "sony,imx219";
								/* FIX: was GPIO_ACTIVE_HIGH, IMX219 reset is active-low */
								reset-gpios = <&ioexpander 1 GPIO_ACTIVE_LOW>;
								reg = <0x10>;
								devnode = "video1";
								physical_w = "3.680";
								physical_h = "2.760";
								sensor_model = "imx219";
								use_sensor_mode_id = "true";

								mode0 {
									mclk_khz = "24000"; num_lanes = "2";
									tegra_sinterface = "serial_b"; phy_mode = "DPHY";
									discontinuous_clk = "yes"; dpcm_enable = "false"; cil_settletime = "0";
									active_w = "3280"; active_h = "2464"; mode_type = "bayer"; pixel_phase = "rggb";
									csi_pixel_bit_depth = "10"; readout_orientation = "90"; line_length = "3448";
									inherent_gain = "1"; mclk_multiplier = "9.33"; pix_clk_hz = "182400000";
									gain_factor = "16"; framerate_factor = "1000000"; exposure_factor = "1000000";
									min_gain_val = "16"; max_gain_val = "170"; step_gain_val = "1"; default_gain = "16";
									min_hdr_ratio = "1"; max_hdr_ratio = "1";
									min_framerate = "2000000"; max_framerate = "21000000"; step_framerate = "1"; default_framerate = "21000000";
									min_exp_time = "13"; max_exp_time = "683709"; step_exp_time = "1"; default_exp_time = "2495";
									embedded_metadata_height = "2";
								};
								mode1 {
									mclk_khz = "24000"; num_lanes = "2";
									tegra_sinterface = "serial_b"; phy_mode = "DPHY";
									discontinuous_clk = "yes"; dpcm_enable = "false"; cil_settletime = "0";
									active_w = "3280"; active_h = "1848"; mode_type = "bayer"; pixel_phase = "rggb";
									csi_pixel_bit_depth = "10"; readout_orientation = "90"; line_length = "3448";
									inherent_gain = "1"; mclk_multiplier = "9.33"; pix_clk_hz = "182400000";
									gain_factor = "16"; framerate_factor = "1000000"; exposure_factor = "1000000";
									min_gain_val = "16"; max_gain_val = "170"; step_gain_val = "1"; default_gain = "16";
									min_hdr_ratio = "1"; max_hdr_ratio = "1";
									min_framerate = "2000000"; max_framerate = "28000000"; step_framerate = "1"; default_framerate = "28000000";
									min_exp_time = "13"; max_exp_time = "683709"; step_exp_time = "1"; default_exp_time = "2495";
									embedded_metadata_height = "2";
								};
								mode2 {
									mclk_khz = "24000"; num_lanes = "2";
									tegra_sinterface = "serial_b"; phy_mode = "DPHY";
									discontinuous_clk = "yes"; dpcm_enable = "false"; cil_settletime = "0";
									active_w = "1920"; active_h = "1080"; mode_type = "bayer"; pixel_phase = "rggb";
									csi_pixel_bit_depth = "10"; readout_orientation = "90"; line_length = "3448";
									inherent_gain = "1"; mclk_multiplier = "9.33"; pix_clk_hz = "182400000";
									gain_factor = "16"; framerate_factor = "1000000"; exposure_factor = "1000000";
									min_gain_val = "16"; max_gain_val = "170"; step_gain_val = "1"; default_gain = "16";
									min_hdr_ratio = "1"; max_hdr_ratio = "1";
									min_framerate = "2000000"; max_framerate = "30000000"; step_framerate = "1"; default_framerate = "30000000";
									min_exp_time = "13"; max_exp_time = "683709"; step_exp_time = "1"; default_exp_time = "2495";
									embedded_metadata_height = "2";
								};
								mode3 {
									mclk_khz = "24000"; num_lanes = "2";
									tegra_sinterface = "serial_b"; phy_mode = "DPHY";
									discontinuous_clk = "yes"; dpcm_enable = "false"; cil_settletime = "0";
									active_w = "1640"; active_h = "1232"; mode_type = "bayer"; pixel_phase = "rggb";
									csi_pixel_bit_depth = "10"; readout_orientation = "90"; line_length = "3448";
									inherent_gain = "1"; mclk_multiplier = "9.33"; pix_clk_hz = "182400000";

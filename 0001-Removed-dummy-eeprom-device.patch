From df4aa0d1edce470453d2239a41bf2ba7d1295cc1 Mon Sep 17 00:00:00 2001
From: mkesgin <metinkesgin@forecr.io>
Date: Wed, 19 Aug 2026 10:34:46 +0300
Subject: [PATCH] Removed dummy eeprom device

---
 ...ra264-p4071-0000-dsboard-thrmax-10GbE.dtsi | 23 +------------------
 .../tegra264-p4071-0000-dsboard-thrmax.dtsi   | 23 +------------------
 ...egra264-p4071-0000-milboard-thr-rev10.dtsi | 22 ------------------
 .../tegra264-p4071-0000-milboard-thr.dtsi     | 23 -------------------
 4 files changed, 2 insertions(+), 89 deletions(-)

diff --git a/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-dsboard-thrmax-10GbE.dtsi b/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-dsboard-thrmax-10GbE.dtsi
index 8e5226eae6..43d95945ba 100644
--- a/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-dsboard-thrmax-10GbE.dtsi
+++ b/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-dsboard-thrmax-10GbE.dtsi
@@ -107,18 +107,7 @@
 
 		i2c@810c640000 {
 			status = "okay";
-			/* CVB EEPROM */
-			eeprom@56 {
-				compatible = "atmel,24c02";
-				reg = <0x56>;
-
-				label = "system";
-				vcc-supply = <&vdd_1v8_cvb>;
-				address-width = <8>;
-				pagesize = <8>;
-				size = <256>;
-				read-only;
-			};
+			
 		};
 
 		i2c@810c6c0000 { // since rev-1.1
@@ -505,16 +494,6 @@
 		};
 	};
 
-	eeprom-manager {
-		data-size = <0x100>;
-		bus@0 {
-			i2c-bus = <&i2c1>;
-			eeprom@1 {
-				slave-address = <0x56>;
-				label = "cvb";
-			};
-		};
-	};
 
 	soc_fan: pwm-fan {
 		compatible = "pwm-fan";
diff --git a/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-dsboard-thrmax.dtsi b/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-dsboard-thrmax.dtsi

+++ b/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-dsboard-thrmax.dtsi
@@ -107,18 +107,7 @@
 
 		i2c@810c640000 {
 			status = "okay";
-			/* CVB EEPROM */
-			eeprom@56 {
-				compatible = "atmel,24c02";
-				reg = <0x56>;
-
-				label = "system";
-				vcc-supply = <&vdd_1v8_cvb>;
-				address-width = <8>;
-				pagesize = <8>;
-				size = <256>;
-				read-only;
-			};
+
 		};
 
 		i2c@810c6c0000 { // since rev-1.1
@@ -505,16 +494,6 @@
 		};
 	};
 
-	eeprom-manager {
-		data-size = <0x100>;
-		bus@0 {
-			i2c-bus = <&i2c1>;
-			eeprom@1 {
-				slave-address = <0x56>;
-				label = "cvb";
-			};
-		};
-	};
 
 	soc_fan: pwm-fan {
 		compatible = "pwm-fan";
diff --git a/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-milboard-thr-rev10.dtsi b/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-milboard-thr-rev10.dtsi
index 219b60a0c1..70d4ced3c5 100644
--- a/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-milboard-thr-rev10.dtsi
+++ b/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-milboard-thr-rev10.dtsi
@@ -107,18 +107,6 @@
 
 		i2c@810c640000 { // I2C1 (CAM_I2C)
 			status = "okay";
-			/* CVB EEPROM */
-			eeprom@56 {
-				compatible = "atmel,24c02";
-				reg = <0x56>;
-
-				label = "system";
-				vcc-supply = <&vdd_1v8_cvb>;
-				address-width = <8>;
-				pagesize = <8>;
-				size = <256>;
-				read-only;
-			};
 		};
 
 		i2c@810c680000 { // I2C8
@@ -628,16 +616,6 @@
 		};
 	};
 
-	eeprom-manager {
-		data-size = <0x100>;
-		bus@0 {
-			i2c-bus = <&i2c1>;
-			eeprom@1 {
-				slave-address = <0x56>;
-				label = "cvb";
-			};
-		};
-	};
 
 	soc_fan: pwm-fan {
 		compatible = "pwm-fan";
diff --git a/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-milboard-thr.dtsi b/hardware/nvidia/t264/nv-public/nv-platform/tegra264-p4071-0000-milboard-thr.dtsi

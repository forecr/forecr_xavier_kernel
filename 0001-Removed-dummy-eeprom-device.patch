-			eeprom@56 {
-				compatible = "atmel,24c02";
-				reg = <0x56>;
-
-				label = "system";
-				vcc-supply = <&vdd_1v8_cvb>;
-				address-width = <8>;
-				pagesize = <8>;
-				size = <256>;
-				read-only;
-			};
 		};
 
 		i2c@810c680000 { // I2C8
@@ -670,17 +658,6 @@
 		};
 	};
 
-	eeprom-manager {
-		data-size = <0x100>;
-		bus@0 {
-			i2c-bus = <&i2c1>;
-			eeprom@1 {
-				slave-address = <0x56>;
-				label = "cvb";
-			};
-		};
-	};
-
